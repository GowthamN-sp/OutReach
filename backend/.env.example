APP_ENV=development
# Defaults to true in development and false in production.
# ALLOW_SIGNUP=false
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
V2_DATABASE_PATH=./data/outreachdesk-v2.db
DAILY_SEND_LIMIT=25

# Optional. Required for Connect Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
ENCRYPTION_KEY=

# Optional public HTTPS origin for opt-in tracking. Restart backend after changing.
# Local testing: intentionally run cloudflared tunnel --url http://localhost:8000
# Copy its temporary HTTPS origin here. Use a stable host for real campaigns.
PUBLIC_BASE_URL=
